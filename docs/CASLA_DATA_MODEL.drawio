        <mxCell id="notFound" value="NOT_FOUND&#xa;Commit not proven; not business failure&#xa;Reconcile / retry SAME command + SAME SyncItemUUID" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1040" y="720" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="noSap" value="Architecture boundary&#xa;NO standard SAP Production Confirmation API&#xa;NO SAP-side background queue / worker" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="430" height="100" as="geometry"/></mxCell>
