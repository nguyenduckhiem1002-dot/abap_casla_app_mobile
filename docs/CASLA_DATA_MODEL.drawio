        <mxCell id="auth" value="CASLA token + active session + device&#xa;RBAC / Work Context&#xa;ActorUserUUID derived server-side" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="guard" value="ZCL_PP_OPERATION_GUARD&#xa;Released SAP CDS read model&#xa;REL; block TECO / CLSD / DLFL&#xa;Configured profile; resolve Plant / WorkCenter / Qty / UoM" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1000" y="90" width="310" height="150" as="geometry"/></mxCell>
        <mxCell id="domain" value="Internal managed RAP domain action&#xa;IN LOCAL MODE inside own behavior pool&#xa;validate worker/password/UoM/qty/idempotency" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="310" width="310" height="130" as="geometry"/></mxCell>
        <mxCell id="balance" value="ZTB_PP_EMP_ALLOC&#xa;Update current balance" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="220" height="90" as="geometry"/></mxCell>
        <mxCell id="ledger" value="ZTB_PP_ALLOC_TXN&#xa;Append immutable POSTED ledger row&#xa;SyncItemUUID + actor/session/device + lineage" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="280" height="120" as="geometry"/></mxCell>
        <mxCell id="rapread" value="Facade reads receipt from RAP transactional buffer&#xa;READ ENTITIES ... BY \\_Transactions IN LOCAL MODE&#xa;(not Open SQL before save)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="270" height="120" as="geometry"/></mxCell>
        <mxCell id="commit" value="Same RAP LUW&#xa;SUCCESS only when mutation path is valid" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="500" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="response" value="HTTP response" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="synced" value="Received SUCCESS&#xa;Mobile -> SYNCED" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="200" height="70" as="geometry"/></mxCell>
        <mxCell id="unknown" value="Timeout / response lost&#xa;Mobile -> UNKNOWN / PENDING_CONFIRMATION&#xa;Never mark business FAILED from network timeout" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="630" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="status" value="getSyncStatus(AccessToken, DeviceID, SyncItemUUID)&#xa;Read committed POSTED ledger receipt for authenticated actor" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="630" width="320" height="100" as="geometry"/></mxCell>
