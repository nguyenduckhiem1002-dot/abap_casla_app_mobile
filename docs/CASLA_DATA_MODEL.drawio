        <mxCell id="mobile" value="Mobile background queue&#xa;Stable SyncItemUUID created BEFORE send" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="240" height="90" as="geometry"/></mxCell>
