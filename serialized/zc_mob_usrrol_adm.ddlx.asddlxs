@UI.headerInfo: {
  typeName: 'Chức danh',
  typeNamePlural: 'Chức danh',
  title: { value: 'RoleName' }
}
annotate entity ZC_MOB_UsrRol_Adm with
{
  @EndUserText.label: 'UUID người dùng'
  @UI.hidden: true
  @EndUserText.label: 'Mã định danh người dùng'
  UserUUID;

  @EndUserText.label: 'Mã chức danh'
  @UI.lineItem: [{ position: 10 }]
  RoleID;

  @EndUserText.label: 'Tên chức danh'
  @UI.lineItem: [{ position: 20 }]
  RoleName;

  @EndUserText.label: 'Trạng thái chức danh'
  @UI.lineItem: [{ position: 30 }]
  RoleStatus;
}
