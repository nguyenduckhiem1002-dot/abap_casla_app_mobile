@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Vị trí làm việc',
  typeNamePlural: 'Danh mục vị trí làm việc',
  title: { value: 'PositionID' },
  description: { value: 'PositionName' }
}
annotate entity ZC_PP_Position_Adm with
{
  @UI.facet: [{
    id: 'General',
    purpose: #STANDARD,
    type: #IDENTIFICATION_REFERENCE,
    label: 'Thông tin vị trí',
    position: 10
  }]

  @EndUserText.label: 'Work Center'
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  WorkCenter;

  @EndUserText.label: 'Vị trí'
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  PositionID;

  @EndUserText.label: 'Mã máy'
  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  MachineID;

  @EndUserText.label: 'Tên vị trí'
  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  PositionName;

  @EndUserText.label: 'Trạng thái'
  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  @UI.selectionField: [{ position: 40 }]
  Status;

  @EndUserText.label: 'Người tạo'
  @UI.identification: [{ position: 110 }]
  CreatedBy;

  @EndUserText.label: 'Thời điểm tạo'
  @UI.identification: [{ position: 120 }]
  CreatedAt;

  @EndUserText.label: 'Người thay đổi cuối cùng'
  @UI.identification: [{ position: 130 }]
  LastChangedBy;

  @EndUserText.label: 'Thời điểm thay đổi cuối cùng'
  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 140 }]
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}
