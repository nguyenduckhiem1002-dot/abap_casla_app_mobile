@EndUserText.label: 'Dịch vụ phân bổ sản lượng công đoạn'
define service ZUI_PP_OPALLOC {
  // The mobile API exposes operation headers plus controlled static actions.
  // Every business command validates CASLA token/session/device, checks the
  // caller's work scope and writes through the RAP domain layer.
  //
  // EmployeeAllocation and AllocationTransaction entity sets stay hidden.
  // Per-worker history is returned only by the token-scoped getWorkHistory
  // action. Ambiguous HTTP outcomes are reconciled by getSyncStatus using the
  // client-generated SyncItemUUID; raw ledger CRUD is never exposed.
  expose ZC_PP_OpAlloc as OperationAllocations;
}
