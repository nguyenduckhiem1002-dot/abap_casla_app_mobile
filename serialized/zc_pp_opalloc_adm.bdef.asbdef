projection;
strict ( 2 );

define behavior for ZC_PP_OpAlloc_Adm alias OperationAllocation
{
  // Bề mặt Fiori được bảo vệ bằng IAM. Không expose create/update tổng quát;
  // người dùng chỉ được sửa số lượng đã xác nhận qua correctConfirm để mỗi
  // thay đổi luôn append một dòng CORRECTION có thể audit vào ledger.
  use action correctConfirm;
}