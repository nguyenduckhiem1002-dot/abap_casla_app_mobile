managed implementation in class zbp_i_mob_role unique;
strict ( 2 );

define behavior for ZI_MOB_Role alias MobileRole
persistent table ztb_mob_role
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;
  field ( readonly : update ) RoleID;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt,
                     LocalLastChangedAt;
  association _Functions { create; }
  association _WorkAssignments { create; }
  validation validateRole on save { create; update; field RoleID, RoleName, Status; }
  mapping for ztb_mob_role {
    RoleID = role_id;
    RoleName = role_name;
    Status = status;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_MOB_RolFunc alias MobileRoleFunc
persistent table ztb_mob_rol_fnc
lock dependent by _Role
authorization dependent by _Role
{
  delete;
  field ( readonly ) RoleID, FuncName, AppModule;
  association _Role;
  validation validateFunctionAssignment on save { create; field FuncID; }
  mapping for ztb_mob_rol_fnc {
    RoleID = role_id;
    FuncID = func_id;
  }
}

define behavior for ZI_MOB_RolWork alias MobileRoleWork
persistent table ztb_mob_rol_wrk
lock dependent by _Role
authorization dependent by _Role
{
  delete;
  field ( readonly ) RoleID, WorkName, Plant, WorkCenter, BoPhan, Location;
  association _Role;
  association _Work;
  validation validateWorkAssignment on save { create; field WorkID; }
  mapping for ztb_mob_rol_wrk {
    RoleID = role_id;
    WorkID = work_id;
  }
}
