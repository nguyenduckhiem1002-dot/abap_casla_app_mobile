
managed implementation in class zbp_i_mob_role unique;
strict ( 2 );
with draft;

define behavior for ZI_MOB_Role alias MobileRole
persistent table ztb_mob_role
draft table ztd_mob_role
lock master
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;
  delete;
  field ( mandatory : create, readonly : update ) RoleID;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt,
                     LocalLastChangedAt;
  association _Functions { create; with draft; }
  association _WorkAssignments { create; with draft; }
  validation validateRole on save { create; update; field RoleID, RoleName, Status; }
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare {
    validation validateRole;
    validation MobileRoleFunc~validateFunctionAssignment;
    validation MobileRoleWork~validateWorkAssignment;
  }
  mapping for ztb_mob_role {
    RoleID = role_id;
    RoleName = role_name;
    Status = status;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LastChangedBy = last_changed_by;
    LastChangedAt = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

define behavior for ZI_MOB_RolFunc alias MobileRoleFunc
persistent table ztb_mob_rol_fnc
draft table ztd_mob_rlfnc
lock dependent by _Role
authorization dependent by _Role
etag dependent by _Role
{
  delete;
  field ( readonly ) RoleID;
  field ( mandatory : create, readonly : update ) FuncID;
  association _Role { with draft; }
  validation validateFunctionAssignment on save { create; field FuncID; }
  mapping for ztb_mob_rol_fnc {
    RoleID = role_id;
    FuncID = func_id;
  }
}

define behavior for ZI_MOB_RolWork alias MobileRoleWork
persistent table ztb_mob_rol_wrk
draft table ztd_mob_rlwrk
lock dependent by _Role
authorization dependent by _Role
etag dependent by _Role
{
  delete;
  field ( readonly ) RoleID;
  field ( mandatory : create, readonly : update ) WorkID;
  association _Role { with draft; }
  validation validateWorkAssignment on save { create; field WorkID; }
  mapping for ztb_mob_rol_wrk {
    RoleID = role_id;
    WorkID = work_id;
  }
}
