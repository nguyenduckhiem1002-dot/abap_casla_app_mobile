managed implementation in class zbp_r_pp_position unique;
strict ( 2 );
with draft;

define behavior for ZR_PP_Position alias Position
persistent table ztb_pp_position
draft table ztd_pp_position
lock master
total etag LastChangedAt
authorization master ( global )
etag master LocalLastChangedAt
{
  create;
  update;

  // Mobile (giám sát): xem sơ đồ ghế, tạo vị trí, đổi máy. Mỗi facade xác thực
  // access token/thiết bị và chỉ cho phép trên Work Center được cấp function
  // PP_POS_MANAGE (ZCL_PP_POSITION_API).
  static action getPositionBoard parameter ZA_PP_PosBoardQuery
    deep result [1] ZA_PP_PosBoardResult;
  static action submitPositionCreate parameter ZA_PP_PosCreateCmd
    result [1] ZA_PP_PosCommandResult;
  static action submitMachineChange parameter ZA_PP_PosMachineCmd
    result [1] ZA_PP_PosCommandResult;

  // Không xóa: ngừng dùng bằng Status = I.
  field ( mandatory : create, readonly : update ) WorkCenter, PositionID, MachineID;
  field ( mandatory ) Status;
  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt,
                     LocalLastChangedAt;

  // Một vị trí chỉ có một máy đang dùng: dòng Active mới làm dòng máy cũ
  // của cùng vị trí tự chuyển I.
  determination deactivateReplacedMachine on save { create; field Status; }

  validation validatePosition on save { create; update; }

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare
  {
    validation validatePosition;
  }

  mapping for ztb_pp_position
  {
    WorkCenter         = work_center;
    PositionID         = position_id;
    MachineID          = machine_id;
    PositionName       = position_name;
    Status             = status;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}
