managed implementation in class zbp_i_mob_user unique;
strict ( 2 );
with draft;

define behavior for ZI_MOB_User alias MobileUser
persistent table ztb_mob_user
draft table ztd_mob_user
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) UserUUID;

  field ( readonly )
  Username,
  NormalizedUsername,
  FailedLoginCount,
  LastFailedLoginAt,
  LockedUntil,
  PasswordChangeRequired,
  FirstLoginAt,
  LastLoginAt,
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;

  field ( readonly : update ) WorkerID;

  association _Credential
  {
    create;
    with draft;
  }

  association _Sessions
  {
    create;
    with draft;
  }

  association _Roles
  {
    create;
    with draft;
  }

  static action createUser
    parameter ZA_MOB_CreateUser
    result [1] $self;

  action changePasswordAdmin
    parameter ZA_MOB_CHANGEPWD_ADMIN;

  action unlockUser result [1] $self;

  static action login
    parameter ZA_MOB_Login
  deep result [1] ZA_MOB_LoginResult;

  static action logout
    parameter ZA_MOB_Token;


  static action refresh
    parameter ZA_MOB_Refresh
  deep result [1] ZA_MOB_LoginResult;

  static action changePassword
    parameter ZA_MOB_ChangePwd;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for ztb_mob_user
    {
      UserUUID               = user_uuid;
      Username               = username;
      NormalizedUsername     = normalized_username;
      FullName               = full_name;
      Email                  = email;
      WorkerID               = worker_id;
      Status                 = status;
      FailedLoginCount       = failed_login_count;
      LastFailedLoginAt      = last_fail_at;
      LockedUntil            = locked_until;
      PasswordChangeRequired = password_change_required;
      FirstLoginAt           = first_login_at;
      LastLoginAt            = last_login_at;
      CreatedBy              = created_by;
      CreatedAt              = created_at;
      LastChangedBy          = last_changed_by;
      LastChangedAt          = last_changed_at;
      LocalLastChangedAt     = local_last_changed_at;
    }
}

define behavior for ZI_MOB_UsrRol alias MobileUserRole
persistent table ztb_mob_usr_rol
draft table ztd_mob_usrrol
lock dependent by _User
authorization dependent by _User
{
  delete;

  field ( readonly )
  UserUUID,
  RoleName,
  RoleStatus;

  association _User
  {
    with draft;
  }

  validation validateRoleAssignment on save
  {
    create;
    field RoleID;
  }

  mapping for ztb_mob_usr_rol
    {
      UserUUID = user_uuid;
      RoleID   = role_id;
    }
}

define behavior for ZI_MOB_Cred alias MobileCredential
persistent table ztb_mob_cred
draft table ztd_mob_cred
lock dependent by _User
authorization dependent by _User
{
  update;

  field ( readonly ) UserUUID;

  association _User
  {
    with draft;
  }

  mapping for ztb_mob_cred
    {
      UserUUID          = user_uuid;
      PasswordHash      = password_hash;
      PasswordSalt      = password_salt;
      HashAlgorithm     = hash_algorithm;
      HashIterations    = hash_iterations;
      PasswordChangedAt = password_changed_at;
      CredentialStatus  = credential_status;
    }
}

define behavior for ZI_MOB_Session alias MobileSession
persistent table ztb_mob_session
draft table ztd_mob_sess
etag master LocalLastChangedAt
lock dependent by _User
authorization dependent by _User
{
  update;
  delete;

  field ( numbering : managed, readonly ) SessionID;

  field ( readonly )
  UserUUID,
  CreatedAt,
  CreatedBy,
  LastChangedAt,
  LastChangedBy,
  LocalLastChangedAt;

  association _User
  {
    with draft;
  }

  mapping for ztb_mob_session
    {
      SessionID          = session_id;
      UserUUID           = user_uuid;
      AccessTokenHash    = access_token_hash;
      RefreshTokenHash   = refresh_token_hash;
      TokenVersion       = token_version;
      LoginAt            = login_at;
      LastActivityAt     = last_activity_at;
      ExpiresAt          = expires_at;
      RefreshExpiresAt   = refresh_expires_at;
      LogoutAt           = logout_at;
      Status             = status;
      DeviceID           = device_id;
      RevokedReason      = revoked_reason;
      CreatedAt          = created_at;
      CreatedBy          = created_by;
      LastChangedAt      = last_changed_at;
      LastChangedBy      = last_changed_by;
      LocalLastChangedAt = local_last_changed_at;
    }
}