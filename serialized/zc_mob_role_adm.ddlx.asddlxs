@Metadata.layer: #CORE

@EndUserText.label: 'Chức danh'
@UI.headerInfo: {
  typeName: 'Chức danh',
  typeNamePlural: 'Chức danh',
  title: { value: 'RoleName' }
}
annotate entity ZC_MOB_Role_Adm with
{
  @UI.facet: [
    {
      id: 'General',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Thông tin chức danh',
      position: 10
    },
    {
      id: 'Functions',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Quyền chức năng',
      position: 20,
      targetElement: '_Functions'
    },
    {
      id: 'WorkAssignments',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Vị trí làm việc',
      position: 30,
      targetElement: '_WorkAssignments'
    }
  ]

  @EndUserText.label: 'Mã chức danh'
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  RoleID;

  @EndUserText.label: 'Tên chức danh'
  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  RoleName;

  @EndUserText.label: 'Trạng thái'
  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  Status;

  @EndUserText.label: 'Người tạo'
  @UI.lineItem: [{ position: 40 }]
  CreatedBy;

  @EndUserText.label: 'Thời điểm tạo'
  @UI.lineItem: [{ position: 50 }]
  CreatedAt;

  @EndUserText.label: 'Người thay đổi cuối cùng'
  @UI.hidden: true
  LastChangedBy;

  @EndUserText.label: 'Thời điểm thay đổi cuối cùng'
  @UI.hidden: true
  LastChangedAt;

  @EndUserText.label: 'Thời điểm thay đổi cục bộ cuối cùng'
  @UI.hidden: true
  LocalLastChangedAt;
}