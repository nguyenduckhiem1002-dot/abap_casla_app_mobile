@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Ca làm việc',
  typeNamePlural: 'Danh mục ca làm việc',
  title: { value: 'ShiftName' },
  description: { value: 'ShiftID' }
}
annotate entity ZC_PP_Shift_Adm with
{
  @UI.facet: [{
    id: 'General', purpose: #STANDARD,
    type: #IDENTIFICATION_REFERENCE,
    label: 'Thông tin ca làm việc', position: 10
  }]
  @EndUserText.label: 'Nhà máy'
  @UI.lineItem: [{ position: 10 }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  Plant;

  @EndUserText.label: 'Mã ca'
  @UI.lineItem: [{ position: 20 }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  ShiftID;

  @EndUserText.label: 'Tên ca'
  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ position: 30 }]
  ShiftName;

  @EndUserText.label: 'Giờ bắt đầu'
  @UI.lineItem: [{ position: 40 }]
  @UI.identification: [{ position: 40 }]
  StartTime;

  @EndUserText.label: 'Giờ kết thúc'
  @UI.lineItem: [{ position: 50 }]
  @UI.identification: [{ position: 50 }]
  EndTime;

  @EndUserText.label: 'Ngày kết thúc: 0 cùng ngày, 1 hôm sau'
  @UI.lineItem: [{ position: 60 }]
  @UI.identification: [{ position: 60 }]
  EndDayOffset;

  @EndUserText.label: 'Múi giờ SAP'
  @UI.lineItem: [{ position: 70 }]
  @UI.identification: [{ position: 70 }]
  TimeZone;

  @EndUserText.label: 'Hiệu lực từ'
  @UI.lineItem: [{ position: 80 }]
  @UI.identification: [{ position: 80 }]
  @UI.selectionField: [{ position: 80 }]
  ValidFrom;

  @EndUserText.label: 'Hiệu lực đến'
  @UI.lineItem: [{ position: 90 }]
  @UI.identification: [{ position: 90 }]
  @UI.selectionField: [{ position: 90 }]
  ValidTo;

  @EndUserText.label: 'Trạng thái'
  @UI.lineItem: [{ position: 100 }]
  @UI.identification: [{ position: 100 }]
  @UI.selectionField: [{ position: 100 }]
  @UI.textArrangement: #TEXT_ONLY
  IsActive;
  @UI.hidden: true
  StatusText;
}
