@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'Chức năng',
  typeNamePlural: 'Danh sách chức năng',
  title: {
    type: #STANDARD,
    value: 'FuncName'
  },
  description: {
    value: 'FuncId'
  }
}

annotate entity ZC_MOB_Func_Adm with
{
  @UI.facet: [{
    id: 'General',
    purpose: #STANDARD,
    type: #IDENTIFICATION_REFERENCE,
    label: 'Thông tin chức năng',
    position: 10
  }]

  @EndUserText.label: 'Mã chức năng'
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem: [{
    position: 10,
    label: 'Mã chức năng',
    importance: #HIGH
  }]
  @UI.identification: [{
    position: 10,
    label: 'Mã chức năng'
  }]
  @EndUserText.label: 'Mã chức năng'
  FuncID;

  @EndUserText.label: 'Tên chức năng'
  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem: [{
    position: 20,
    label: 'Tên chức năng',
    importance: #HIGH
  }]
  @UI.identification: [{
    position: 20,
    label: 'Tên chức năng'
  }]
  FuncName;

  @EndUserText.label: 'Phân hệ ứng dụng'
  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem: [{
    position: 30,
    label: 'Phân hệ ứng dụng',
    importance: #MEDIUM
  }]
  @UI.identification: [{
    position: 30,
    label: 'Phân hệ ứng dụng'
  }]
  AppModule;
}
