projection;
strict ( 2 );

define behavior for ZC_PP_OpAlloc alias OperationAllocation
{
  use create;
  use update;
  use action initialAssign;
  use action transfer;
  use action confirm;
  use action reverse;
  use association _Employees { create; }
  use association _Transactions { create; }
}

define behavior for ZC_PP_EmpAlloc alias EmployeeAllocation
{
  use update;
  use association _Operation;
}

define behavior for ZC_PP_AllocTxn alias AllocationTransaction
{
  use association _Operation;
}

