projection;
strict ( 2 );

define behavior for ZC_PP_OpAlloc alias OperationAllocation
{
  // Mobile commands are exposed only through these static facade actions.
  // Each facade validates the CASLA access token/session/device before it
  // resolves the SAP operation and delegates to the internal domain action.
  use action submitInitialAssign;
  use action submitTransfer;
  use action submitRecall;
  use action submitConfirm;
  use action submitReverse;

  // Used after an ambiguous HTTP timeout. SUCCESS proves a committed ledger
  // receipt; NOT_FOUND means the backend cannot prove a commit and is not a
  // business failure.
  use action getSyncStatus;

  // Token-scoped read-only report.
  use action getWorkHistory;
}
