
projection;
strict ( 2 );
use draft;

define behavior for ZC_MOB_Role_Adm alias MobileRole
use etag
{
  use create;
  use update;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;
  use association _Functions { create; with draft; }
  use association _WorkAssignments { create; with draft; }
}

define behavior for ZC_MOB_RolFunc_Adm alias MobileRoleFunc
use etag
{
  use delete;
  use association _Role { with draft; }
}

define behavior for ZC_MOB_RolWork_Adm alias MobileRoleWork
use etag
{
  use delete;
  use association _Role { with draft; }
}
