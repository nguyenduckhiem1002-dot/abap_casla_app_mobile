projection;
strict ( 2 );

"Role and function maintenance is administrative: exposed on
"ZUI_MOB_RBAC_ADM only, never on the mobile auth service. The app reads
"the outcome through the getPermissions action, which returns nothing but
"the caller's own effective functions.
define behavior for ZC_MOB_Role_Adm alias MobileRole
{
  use create;
  use update;
  use delete;
  use association _Functions { create; }
}

define behavior for ZC_MOB_RolFunc_Adm alias MobileRoleFunc
{
  use update;
  use delete;
  use association _Role;
}
