projection;
strict ( 2 );

// Bề mặt quản trị, chỉ được truy cập qua ứng dụng IAM của ZUI_MOB_USER_ADM.
// Tạo tài khoản và gán chức danh được thực hiện tại đây và cố ý không expose
// qua ZC_MOB_User, là projection dành cho thiết bị mobile.
define behavior for ZC_MOB_User_Adm alias MobileUser
{
  use action createUser;
  use association _Roles { create; }
}

define behavior for ZC_MOB_UsrRol_Adm alias MobileUserRole
{
  use delete;
  use association _User;
}
