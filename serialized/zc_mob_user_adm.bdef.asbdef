projection;
strict ( 2 );

"Administrative surface, reachable only through the IAM app of
"ZUI_MOB_USER_ADM. Account creation and role assignment live here and are
"deliberately absent from ZC_MOB_User, the device-facing projection.
define behavior for ZC_MOB_User_Adm alias MobileUser
{
  use action createUser;
  use association _Roles { create; }
}

define behavior for ZC_MOB_UsrRol_Adm alias MobileUserRole
{
  use update;
  use delete;
  use association _User;
}
