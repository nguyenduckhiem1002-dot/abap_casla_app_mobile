@EndUserText.label : 'Phiên đăng nhập ứng dụng di động'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table ztb_mob_session {
  key client            : abap.clnt not null;
  key session_id        : sysuuid_x16 not null;
  user_uuid             : sysuuid_x16 not null;
  access_token_hash     : abap.char(128) not null;
  refresh_token_hash    : abap.char(128);
  token_version         : abap.int4 not null;
  login_at              : abap.utclong not null;
  last_activity_at      : abap.utclong not null;
  expires_at            : abap.utclong not null;
  refresh_expires_at    : abap.utclong;
  logout_at             : abap.utclong;
  status                : abap.char(1) not null;
  device_id             : abap.char(120) not null;
  revoked_reason        : abap.char(40);
  created_at            : abp_creation_tstmpl;
  created_by            : abp_creation_user;
  last_changed_at       : abp_lastchange_tstmpl;
  last_changed_by       : abp_lastchange_user;
  local_last_changed_at : abp_locinst_lastchange_tstmpl;
}
